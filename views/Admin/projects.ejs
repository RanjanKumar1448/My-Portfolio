<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin-projects-page</title>
  <link rel="stylesheet" href="/style.css">
</head> 
<body>
  <section id="projects">
  <h3>Admin can manage project from here:)</h3>
    <% for (let project of projects) { %>

        <div class="project-card">

            <h3><%= project.name %></h3>

            <p><%= project.description %></p>

            <p>
                <strong>Technologies:</strong>
                <%= project.technologies %>
            </p>

            <% if (project.github) { %>
                <a href="<%= project.github %>" target="_blank">
                    GitHub
                </a>

                
            <% } %>

        </div>
      <a href="/admin/projects/edit/<%= project.id %>">
            Edit
        </a>
        <form action="/admin/projects/delete/<%= project.id %>?_method=DELETE" method="POST" style="display: inline">
            <button type="submit">Delete</button>
        </form>
    <% } %>
    <br><br>
<a href="/Admin/dashbord.ejs">← Back to Dashboard</a>
</section>

</body>
</html>