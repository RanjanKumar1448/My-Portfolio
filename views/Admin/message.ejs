<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>view message</title>
</head>
<body>
  
    <h1>Messages</h1>

    <p>Here you can view messages received from visitors.</p>

    <a href="/Admin/dashbord.ejs">← Back to Dashboard</a>

    <hr>
<% for(let message of messages){ %>
  <div class="message-card">
   <h2><%= message.name %></h2>
   <p>
     <strong>Email:</strong>
    <%= message.email %>
  </p>
   <p>
     <strong>Message:</strong>
    <%= message.message %>
  </p>
  </div>
       
  <% } %>
</body>
</html>



