<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>show skill</title>
 <link rel="stylesheet" href="/style.css">
</head>
<body>
  <section id="skills">
  <h2>My Skills</h2>
  <div>
    <ul>
    <% for(let skill of skills){ %> 
      <li><%= skill.name %></li>
      <% } %>
    </ul>
  </div>
</section>
</body>
</html>



