<section id="projects">

    <h2>My Projects</h2>

    <% for (let project of projects) { %>

        <div class="project-card">

            <h3><%= project.name %></h3>

            <p><%= project.description %></p>

            <p>
                <strong>Technologies:</strong>
                <%= project.technologies %>
            </p>

            <% if (project.github) { %>
                <a href="<%= project.github %>" target="_blank">
                    GitHub
                </a>
            <% } %>

        </div>

    <% } %>

</section>
